# Production Docker — HTTP-first на Droplet 161.35.65.129
# На сервері: cp .env.docker.example .env && nano .env
# Не комітити .env.
# Обов'язково зміни SECRET_KEY і DB_PASSWORD перед deploy.sh.

SECRET_KEY=replace-me-with-a-long-random-string
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.production

# Реальний IPv4 у ALLOWED_HOSTS/CSRF — інакше 400 DisallowedHost.
ALLOWED_HOSTS=161.35.65.129,127.0.0.1,localhost,web
CSRF_TRUSTED_ORIGINS=http://161.35.65.129

# HTTP test: False. Після Let's Encrypt → True.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False

DB_NAME=svbeauty
DB_USER=svbeauty
DB_PASSWORD=replace-me
DB_HOST=db
DB_PORT=5432

HTTP_PORT=80

DEFAULT_FROM_EMAIL=noreply@svbeauty.com.ua
MANAGER_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

NOVAPOSHTA_API_KEY=

LIQPAY_ENABLED=False
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=

REVIEWS_ENABLED=False
