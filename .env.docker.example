# Production Docker — HTTPS svbeauty.com.ua (сертифікат у /etc/letsencrypt).
# На сервері: bash deploy/docker/gen-env.sh
# Не комітити .env. SECRET_KEY і DB_PASSWORD скрипт підставляє сам.
# Якщо .env уже є — не перегенеровувати: пароль Postgres у томі не зміниться.

SECRET_KEY=replace-me-with-a-long-random-string
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.production
# Не admin. ERR-132.
ADMIN_URL=sv-desk

# Домен обов'язковий, інакше 400 DisallowedHost / CSRF на HTTPS.
ALLOWED_HOSTS=svbeauty.com.ua,www.svbeauty.com.ua,201.79.15.126,127.0.0.1,localhost,web
CSRF_TRUSTED_ORIGINS=https://svbeauty.com.ua,https://www.svbeauty.com.ua

# Secure-куки для HTTPS. Редірект лишається на nginx:
# SECURE_SSL_REDIRECT=True ламає /healthz/ всередині контейнера (там HTTP).
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=False

DB_NAME=svbeauty
DB_USER=svbeauty
DB_PASSWORD=replace-me
DB_HOST=db
DB_PORT=5432

HTTP_PORT=80

DEFAULT_FROM_EMAIL=noreply@svbeauty.com.ua
MANAGER_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

NOVAPOSHTA_API_KEY=

# Картка вимкнена, доки немає ключів ФОП і callback LiqPay.
# Sandbox-ключі не вмикати: кнопка є, оплата не проходить.
LIQPAY_ENABLED=False
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=

REVIEWS_ENABLED=False
