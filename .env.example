# Скопіюй у `.env` і заповни своїми значеннями.
# У цьому файлі НЕМАЄ реальних паролів/ключів — лише плейсхолдери.

# Django
SECRET_KEY=replace-me-with-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Не admin. ERR-132.
ADMIN_URL=sv-desk

# База даних (локально можна: DB_ENGINE=sqlite і решту DB_* не задавати)
DB_ENGINE=postgres
DB_NAME=svbeauty
DB_USER=svbeauty
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=5432

# Пошта (порожні credentials = консоль/локальний SMTP без секрету)
DEFAULT_FROM_EMAIL=noreply@example.com
MANAGER_EMAIL=manager@example.com
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Нова Пошта (порожньо — тестовий довідник без API-ключа)
NOVAPOSHTA_API_KEY=

# Картка вимкнена, доки немає ключів ФОП. Callback у коді немає.
LIQPAY_ENABLED=False
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=

# Відгуки/зірки на вітрині (True — показати знову)
REVIEWS_ENABLED=False
