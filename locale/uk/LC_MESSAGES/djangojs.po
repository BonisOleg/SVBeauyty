# Ukrainian overrides for Django admin JavaScript (SelectFilter / filter_horizontal).
msgid ""
msgstr ""
"Project-Id-Version: SVbeauty\n"
"Language: uk\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=4; plural=(n % 1 == 0 && n % 10 == 1 && n % 100 != 11 "
"? 0 : n % 1 == 0 && n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % "
"100 > 14) ? 1 : n % 1 == 0 && (n % 10 ==0 || (n % 10 >=5 && n % 10 <=9) || "
"(n % 100 >=11 && n % 100 <=14 )) ? 2: 3);\n"

#, javascript-format
msgid ""
"Choose %s by selecting them and then select the \"Choose\" arrow button."
msgstr ""
"Оберіть %s, виділивши їх у списку і натиснувши стрілку «Обрати»."

#, javascript-format
msgid "Choose all %s"
msgstr "Обрати всі %s"

#, javascript-format
msgid "Choose selected %s"
msgstr "Обрати вибрані %s"

#, javascript-format
msgid "Remove selected %s"
msgstr "Вилучити вибрані %s"

#, javascript-format
msgid ""
"Remove %s by selecting them and then select the \"Remove\" arrow button."
msgstr ""
"Вилучіть %s, виділивши їх у списку і натиснувши стрілку «Вилучити»."

#, javascript-format
msgid "Type into this box to filter down the list of selected %s."
msgstr ""
"Почніть вводити текст у цьому полі, щоб відфільтрувати список обраних %s."

msgid "(click to clear)"
msgstr "(натисніть, щоб очистити)"

#, javascript-format
msgid "Remove all %s"
msgstr "Вилучити всі %s"

#, javascript-format
msgid "%s selected option not visible"
msgid_plural "%s selected options not visible"
msgstr[0] "%s вибраний елемент не видно"
msgstr[1] "%s вибрані елементи не видно"
msgstr[2] "%s вибраних елементів не видно"
msgstr[3] "%s вибраних елементів не видно"
